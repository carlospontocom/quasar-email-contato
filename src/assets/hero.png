geFix\" result=\"shape\"/\u003e\u003cfeGaussianBlur result=\"effect1_foregroundBlur_2002_17286\" stdDeviation=\"4.596\"/\u003e\u003c/filter\u003e\u003cfilter id=\"n\" width=\"54.814\" height=\"64.646\" x=\"-15.081\" y=\"6.78\" color-interpolation-filters=\"sRGB\" filterUnits=\"userSpaceOnUse\"\u003e\u003cfeFlood flood-opacity=\"0\" result=\"BackgroundImageFix\"/\u003e\u003cfeBlend in=\"SourceGraphic\" in2=\"BackgroundImageFix\" result=\"shape\"/\u003e\u003cfeGaussianBlur result=\"effect1_foregroundBlur_2002_17286\" stdDeviation=\"4.596\"/\u003e\u003c/filter\u003e\u003cfilter id=\"o\" width=\"54.814\" height=\"64.646\" x=\"22.45\" y=\"-1.645\" color-interpolation-filters=\"sRGB\" filterUnits=\"userSpaceOnUse\"\u003e\u003cfeFlood flood-opacity=\"0\" result=\"BackgroundImageFix\"/\u003e\u003cfeBlend in=\"SourceGraphic\" in2=\"BackgroundImageFix\" result=\"shape\"/\u003e\u003cfeGaussianBlur result=\"effect1_foregroundBlur_2002_17286\" stdDeviation=\"4.596\"/\u003e\u003c/filter\u003e\u003cfilter id=\"p\" width=\"39.409\" height=\"43.623\" x=\"32.919\" y=\"11.36\" color-interpolation-filters=\"sRGB\" filterUnits=\"userSpaceOnUse\"\u003e\u003cfeFlood flood-opacity=\"0\" result=\"BackgroundImageFix\"/\u003e\u003cfeBlend in=\"SourceGraphic\" in2=\"BackgroundImageFix\" result=\"shape\"/\u003e\u003cfeGaussianBlur result=\"effect1_foregroundBlur_2002_17286\" stdDeviation=\"4.596\"/\u003e\u003c/filter\u003e\u003c/defs\u003e\u003c/svg\u003e\n","fullPath":"src/assets/vite.svg","isBinary":false,"lastModified":1786813216698},"src/router/index.ts":{"name":"index.ts","type":"file","contents":"import { createRouter, createWebHistory } from 'vue-router';\n\nconst routes = [\n  {\n    path: '/',\n    component: () =\u003e import('../layouts/MainLayout.vue'),\n    children: [\n      { path: '', name: 'index', component: () =\u003e import('../pages/IndexPage.vue') },\n      { path: 'about', name: 'about', component: () =\u003e import('../pages/AboutPage.vue') },\n    ],\n  },\n  {\n    path: '/:catchAll(.*)*',\n    component: () =\u003e import('../pages/ErrorNotFound.vue'),\n  },\n];\n\nconst router = createRouter({\n  history: createWebHistory(import.meta.env.BASE_URL),\n  routes,\n  scrollBehavior: () =\u003e ({ left: 0, top: 0 }),\n});\n\nexport default router;\n","fullPath":"src/router/index.ts","isBinary":false,"lastModified":1786813216698},"src/pages/AboutPage.vue":{"name":"AboutPage.vue","type":"file","contents":"\u003ctemplate\u003e\n  \u003cq-page class=\"flex flex-center\"\u003e\n    \u003cq-card flat bordered style=\"max-width: 560px\" class=\"q-pa-lg\"\u003e\n      \u003cq-card-section class=\"text-center\"\u003e\n        \u003cq-icon name=\"info\" color=\"primary\" size=\"56px\" class=\"q-mb-sm\" /\u003e\n        \u003ch2 class=\"text-h5 text-weight-medium q-mb-sm\"\u003eSobre este app\u003c/h2\u003e\n        \u003cp class=\"text-body1 text-grey-8\"\u003e\n          Este é um aplicativo de exemplo construído com\n          \u003cstrong\u003eQuasar Framework\u003c/strong\u003e e \u003cstrong\u003eVue 3\u003c/strong\u003e, usando Vite como\n          ferramenta de build. Ele demonstra uma estrutura padrão com layout, drawer\n          lateral, cabeçalho, rodapé, roteamento entre páginas e modo escuro.\n        \u003c/p\u003e\n      \u003c/q-card-section\u003e\n\n      \u003cq-separator inset class=\"q-my-md\" /\u003e\n\n      \u003cq-list\u003e\n        \u003cq-item\u003e\n          \u003cq-item-section avatar\u003e\n            \u003cq-icon name=\"layers\" color=\"primary\" /\u003e\n          \u003c/q-item-section\u003e\n          \u003cq-item-section\u003e\n            \u003cq-item-label\u003eFramework\u003c/q-item-label\u003e\n            \u003cq-item-label caption\u003eQuasar {{ quasarVersion }}\u003c/q-item-label\u003e\n          \u003c/q-item-section\u003e\n        \u003c/q-item\u003e\n\n        \u003cq-item\u003e\n          \u003cq-item-section avatar\u003e\n            \u003cq-icon name=\"code\" color=\"secondary\" /\u003e\n          \u003c/q-item-section\u003e\n          \u003cq-item-section\u003e\n            \u003cq-item-label\u003eLinguagem\u003c/q-item-label\u003e\n            \u003cq-item-label caption\u003eVue 3 + TypeScript\u003c/q-item-label\u003e\n          \u003c/q-item-section\u003e\n        \u003c/q-item\u003e\n\n        \u003cq-item\u003e\n          \u003cq-item-section avatar\u003e\n            \u003cq-icon name=\"bolt\" color=\"accent\" /\u003e\n          \u003c/q-item-section\u003e\n          \u003cq-item-section\u003e\n            \u003cq-item-label\u003eBuild\u003c/q-item-label\u003e\n            \u003cq-item-label caption\u003eVite\u003c/q-item-label\u003e\n          \u003c/q-item-section\u003e\n        \u003c/q-item\u003e\n      \u003c/q-list\u003e\n\n      \u003cq-card-actions align=\"center\" class=\"q-mt-md\"\u003e\n        \u003cq-btn flat color=\"primary\" label=\"Voltar ao início\" icon=\"arrow_back\" to=\"/\" /\u003e\n      \u003c/q-card-actions\u003e\n    \u003c/q-card\u003e\n  \u003c/q-page\u003e\n\u003c/template\u003e\n\n\u003cscript setup lang=\"ts\"\u003e\nimport { useQuasar } from 'quasar';\n\nconst $q = useQuasar();\nconst quasarVersion = $q.version;\n\u003c/script\u003e\n","fullPath":"src/pages/AboutPage.vue","isBinary":false,"lastModified":1786813216698},"src/pages/IndexPage.vue":{"name":"IndexPage.vue","type":"file","contents":"\u003ctemplate\u003e\n  \u003cq-page class=\"flex flex-center\"\u003e\n    \u003cdiv class=\"q-pa-xl text-center\" style=\"max-width: 600px\"\u003e\n      \u003cq-icon name=\"rocket_launch\" color=\"primary\" size=\"80px\" class=\"q-mb-md\" /\u003e\n\n      \u003ch1 class=\"text-h4 text-weight-medium q-mb-sm\"\u003eBem-vindo ao Quasar\u003c/h1\u003e\n      \u003cp class=\"text-body1 text-grey-7 q-mb-lg\"\u003e\n        Um framework completo para construir apps Vue 3 responsivos — web, mobile e desktop\n        a partir de uma única base de código.\n      \u003c/p\u003e\n\n      \u003cdiv class=\"row q-gutter-md justify-center q-mb-lg\"\u003e\n        \u003cq-btn push color=\"primary\" icon=\"play_arrow\" label=\"Começar\" to=\"/about\" size=\"md\" /\u003e\n        \u003cq-btn push color=\"secondary\" icon=\"book\" label=\"Docs\" type=\"a\" href=\"https://quasar.dev\" target=\"_blank\" size=\"md\" /\u003e\n      \u003c/div\u003e\n\n      \u003cq-separator spaced class=\"q-my-lg\" /\u003e\n\n      \u003cdiv class=\"row q-col-gutter-md\"\u003e\n        \u003cdiv class=\"col-12 col-sm-4\" v-for=\"card in cards\" :key=\"card.title\"\u003e\n          \u003cq-card flat bordered class=\"full-height\"\u003e\n            \u003cq-item\u003e\n              \u003cq-item-section avatar\u003e\n                \u003cq-avatar :color=\"card.color\" text-color=\"white\" :icon=\"card.icon\" /\u003e\n              \u003c/q-item-section\u003e\n              \u003cq-item-section\u003e\n                \u003cq-item-label class=\"text-weight-medium\"\u003e{{ card.title }}\u003c/q-item-label\u003e\n                \u003cq-item-label caption\u003e{{ card.subtitle }}\u003c/q-item-label\u003e\n              \u003c/q-item-section\u003e\n            \u003c/q-item\u003e\n            \u003cq-separator /\u003e\n            \u003cq-card-section class=\"text-body2 text-grey-8\"\u003e\n              {{ card.text }}\n            \u003c/q-card-section\u003e\n          \u003c/q-card\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cq-separator spaced class=\"q-my-lg\" /\u003e\n\n      \u003cq-btn\n        color=\"accent\"\n        icon=\"notifications\"\n        label=\"Mostrar notificação\"\n        unelevated\n        size=\"md\"\n        @click=\"showNotify\"\n      /\u003e\n    \u003c/div\u003e\n  \u003c/q-page\u003e\n\u003c/template\u003e\n\n\u003cscript setup lang=\"ts\"\u003e\nimport { useQuasar } from 'quasar';\n\nconst $q = useQuasar();\n\nconst cards = [\n  {\n    title: 'Responsivo',\n    subtitle: 'Mobile e desktop',\n    icon: 'devices',\n    color: 'primary',\n    text: 'Layouts que se adaptam a qualquer tela, do celular ao monitor ultrawide.',\n  },\n  {\n    title: 'Componentes',\n    subtitle: '80+ prontos para usar',\n    icon: 'widgets',\n    color: 'secondary',\n    text: 'Botões, tabelas, diálogos, sliders e muito mais, com tema personalizável.',\n  },\n  {\n    title: 'Produtividade',\n    subtitle: 'Tudo integrado',\n    icon: 'speed',\n    color: 'accent',\n    text: 'Roteamento, ícones, notificações e dark mode já configurados para você.',\n  },\n];\n\nfunction showNotify() {\n  $q.notify({\n    type: 'positive',\n    message: 'Quasar está funcionando perfeitamente!',\n    icon: 'check_circle',\n    position: 'top',\n  });\n}\n\u003c/script\u003e\n","fullPath":"src/pages/IndexPage.vue","isBinary":false,"lastModified":1786813216698},"src/quasar-variables.sass":{"name":"quasar-variables.sass","type":"file","contents":"// Quasar SCSS(Sass) Variables\n// -------------------------------------------------\n// To customize the look and feel of this app, you can override the Sass variables found in Quasar's source Sass files.\n\n// Check documentation for full list of variables\n\n// Brand colors\n$primary   : #1976d2\n$secondary : #26a69a\n$accent    : #9c27b0\n\n$dark      : #1d1d1d\n$dark-page : #121212\n\n$positive  : #21ba45\n$negative  : #c10015\n$info      : #31ccec\n$warning   : #f2c037\n\n// Typography\n$typography-font-family: 'Roboto', 'Helvetica Neue', Arial, sans-serif\n\n// Layout breakpoints\n$breakpoint-xs: 599px\n$breakpoint-sm: 1023px\n$breakpoint-md: 1439px\n$breakpoint-lg: 1919px\n","fullPath":"src/quasar-variables.sass","isBinary":false,"lastModified":1786813216698},"src/layouts/MainLayout.vue":{"name":"MainLayout.vue","type":"file","contents":"\u003ctemplate\u003e\n  \u003cq-layout view=\"hHh Lpr lFf\"\u003e\n    \u003cq-header elevated class=\"bg-primary text-white\"\u003e\n      \u003cq-toolbar\u003e\n        \u003cq-btn flat dense round icon=\"menu\" aria-label=\"Menu\" @click=\"toggleLeftDrawer\" /\u003e\n\n        \u003cq-toolbar-title\u003e\n          \u003cq-avatar size=\"32px\" class=\"q-mr-sm\"\u003e\n            \u003cimg src=\"https://cdn.quasar.dev/logo-v2/svg/logo-dark.svg\" alt=\"logo\" /\u003e\n          \u003c/q-avatar\u003e\n          Meu App Quasar\n        \u003c/q-toolbar-title\u003e\n\n        \u003cq-btn flat round dense icon=\"dark_mode\" @click=\"toggleDarkMode\"\u003e\n          \u003cq-tooltip\u003eAlternar tema\u003c/q-tooltip\u003e\n        \u003c/q-btn\u003e\n      \u003c/q-toolbar\u003e\n    \u003c/q-header\u003e\n\n    \u003cq-drawer v-model=\"leftDrawerOpen\" show-if-above :width=\"260\" class=\"bg-grey-1\"\u003e\n      \u003cq-list padding\u003e\n        \u003cq-item-label header\u003eMenu\u003c/q-item-label\u003e\n\n        \u003cq-item to=\"/\" exact clickable v-ripple\u003e\n          \u003cq-item-section avatar\u003e\n            \u003cq-icon name=\"home\" /\u003e\n          \u003c/q-item-section\u003e\n          \u003cq-item-section\u003e\n            \u003cq-item-label\u003eInício\u003c/q-item-label\u003e\n            \u003cq-item-label caption\u003ePágina principal\u003c/q-item-label\u003e\n          \u003c/q-item-section\u003e\n        \u003c/q-item\u003e\n\n        \u003cq-item to=\"/about\" exact clickable v-ripple\u003e\n          \u003cq-item-section avatar\u003e\n            \u003cq-icon name=\"info\" /\u003e\n          \u003c/q-item-section\u003e\n          \u003cq-item-section\u003e\n            \u003cq-item-label\u003eSobre\u003c/q-item-label\u003e\n            \u003cq-item-label caption\u003eSobre o app\u003c/q-item-label\u003e\n          \u003c/q-item-section\u003e\n        \u003c/q-item\u003e\n\n        \u003cq-separator spaced /\u003e\n\n        \u003cq-item-label header\u003eLinks\u003c/q-item-label\u003e\n\n        \u003cq-item clickable v-ripple tag=\"a\" href=\"https://quasar.dev\" target=\"_blank\"\u003e\n          \u003cq-item-section avatar\u003e\n            \u003cq-icon name=\"school\" /\u003e\n          \u003c/q-item-section\u003e\n          \u003cq-item-section\u003e\n            \u003cq-item-label\u003eDocumentação\u003c/q-item-label\u003e\n            \u003cq-item-label caption\u003equasar.dev\u003c/q-item-label\u003e\n          \u003c/q-item-section\u003e\n        \u003c/q-item\u003e\n\n        \u003cq-item clickable v-ripple tag=\"a\" href=\"https://github.com/quasarframework\" target=\"_blank\"\u003e\n          \u003cq-item-section avatar\u003e\n            \u003cq-icon name=\"code\" /\u003e\n          \u003c/q-item-section\u003e\n          \u003cq-item-section\u003e\n            \u003cq-item-label\u003eGitHub\u003c/q-item-label\u003e\n            \u003cq-item-label caption\u003equasarframework\u003c/q-item-label\u003e\n          \u003c/q-item-section\u003e\n        \u003c/q-item\u003e\n      \u003c/q-list\u003e\n    \u003c/q-drawer\u003e\n\n    \u003cq-page-container\u003e\n      \u003crouter-view /\u003e\n    \u003c/q-page-container\u003e\n\n    \u003cq-footer elevated class=\"bg-grey-8 text-white\"\u003e\n      \u003cq-toolbar\u003e\n        \u003cq-toolbar-title class=\"text-center\"\u003e\n          \u003cdiv class=\"text-caption\"\u003eFeito com Quasar \u0026amp; Vue 3 — {{ new Date().getFullYear() }}\u003c/div\u003e\n        \u003c/q-toolbar-title\u003e\n      \u003c/q-toolbar\u003e\n    \u003c/q-footer\u003e\n  \u003c/q-layout\u003e\n\u003c/template\u003e\n\n\u003cscript setup lang=\"ts\"\u003e\nimport { ref } from 'vue';\nimport { useQuasar } from 'quasar';\n\nconst $q = useQuasar();\nconst leftDrawerOpen = ref(false);\n\nfunction toggleLeftDrawer() {\n  leftDrawerOpen.value = !leftDrawerOpen.value;\n}\n\nfunction toggleDarkMode() {\n  $q.dark.toggle();\n}\n\u003c/script\u003e\n","fullPath":"src/layouts/MainLayout.vue","isBinary":false,"lastModified":1786813216698},"src/pages/ErrorNotFound.vue":{"name":"ErrorNotFound.vue","type":"file","contents":"\u003ctemplate\u003e\n  \u003cq-page class=\"flex flex-center text-center\"\u003e\n    \u003cdiv\u003e\n      \u003cdiv class=\"text-h1 text-weight-bolder text-primary\" style=\"font-size: 120px; line-height: 1\"\u003e\n        404\n      \u003c/div\u003e\n      \u003cdiv class=\"text-h5 text-grey-8 q-mb-md\"\u003ePágina não encontrada\u003c/div\u003e\n      \u003cdiv class=\"text-body1 text-grey-6 q-mb-lg\" style=\"max-width: 420px\"\u003e\n        A página que você procura não existe ou foi movida.\n      \u003c/div\u003e\n      \u003cq-btn color=\"primary\" icon=\"home\" label=\"Ir para o início\" to=\"/\" unelevated /\u003e\n    \u003c/div\u003e\n  \u003c/q-page\u003e\n\u003c/template\u003e\n\n\u003cscript setup lang=\"ts\"\u003e\n//\n\u003c/script\u003e\n","fullPath":"src/pages/ErrorNotFound.vue","isBinary":false,"lastModified":1786813216698}},"brokenAssets":[],"canAdministrate":true,"canChangeVisibility":true,"canEdit":true,"canFork":true,"canForkToPersonal":true,"canHostWithoutBadge":false,"canMakePrivate":true,"canManage":true,"canShare":true,"canTransfer":true,"canUpdateSettings":true,"canUploadFiles":true,"canUseCorsProxy":false,"canUseLocalhostAccess":false,"canUsePaidFeatures":false,"canView":true,"commercial":false,"contentHash":"f8655c53496101ff11ed3912f4b1c72c3c27802b547fd410561f122bd045a83a","currentUserIsOwner":true,"dependencies":{"jpack":{"appDependencies":{},"resDependencies":{}},"externalDeps":[],"externalResources":[]},"description":"Next generation frontend tooling. It's fast!","editedAt":"2026-08-15T17:00:17.040Z","forkTargets":[{"action":"fork","default":true,"target":{"avatar":"https://avatars.githubusercontent.com/u/235927142","kind":"USER","name":"frontendcnn","provider":null,"slug":"frontendcnn"}}],"forks":0,"framework":{"logoDarkUrl":"https://c.staticblitz.com/assets/frameworks/quasar-3395cd1a470c34b0044da872cc5031ab5845e876735bf40f15f0e3a449f55ffe.svg","logoUrl":"https://c.staticblitz.com/assets/frameworks/quasar-3395cd1a470c34b0044da872cc5031ab5845e876735bf40f15f0e3a449f55ffe.svg","slug":"quasar"},"frozen":null,"guestId":null,"hasBrokenAssets":false,"id":69977660,"